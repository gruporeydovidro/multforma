  object ADOCmdGerar: TMultADOCMD
    CommandTimeout = 120
    Connection = FrmMain.ADOConMaster
    Parameters = <>
    SQLOther0.Strings = (
      '-------------------- Exclui os itens caso solicitado'
      'delete from'
      '  Inventario_Trimestral_Produto'
      ''
      'where'
      '  Cd_Filial = :Cd_Filial and'
      '  Nr_Ano    = :Nr_Ano'
      ''
    )
    SQLOther1.Strings = (
      '-------------------- Importa os produtos'
      'declare'
      '  @Cd_Filial SmallInt,'
      '  @Nr_Ano VarChar( 5 )'
      ''
      'select'
      '  @Cd_Filial = :Cd_Filial,'
      '  @Nr_Ano    = :Nr_Ano'
      ''
      'insert into Inventario_Trimestral_Produto( Cd_Filial, Nr_Ano, Cd_Produto, Qt_Anterior,'
      '  Qt_Entradas, Qt_Saidas, Vl_Custo, Fl_Inventario )'
      ''
      'select'
      '  @Cd_Filial, @Nr_Ano, P.Cd_Produto, 0, 0, 0, Coalesce( PP.Vl_Custo, 0.01 ),'
      '  G.Fl_Inventario'
      ''
      'from'
      '  Produto P'
      ''
      'inner join'
      '  Grupo G'
      'on'
      '  G.Cd_Grupo = P.Cd_Grupo'
      ''
      'left join'
      '  Produto_Preco PP'
      'on'
      '  PP.Cd_Tabela  = :Cd_Tabela and'
      '  PP.Cd_Produto = P.Cd_Produto'
      ''
      'where'
      '  P.Fl_Produto = ''''1'''' and'
      ''
      '  not exists('
      '    select'
      '      IP.Cd_Produto'
      ''
      '    from'
      '      Inventario_Trimestral_Produto IP'
      ''
      '    where'
      '      IP.Cd_Filial  = @Cd_Filial and'
      '      IP.Nr_Ano     = @Nr_Ano and'
      '      IP.Cd_Produto = P.Cd_Produto'
      '    )'
      ''
      '  /* Fl_Ativo */'
    )
    SQLOther2.Strings = (
      '-------------------- Saldo anterior do inventario anterior'
      'update'
      '  Inventario_Trimestral_Produto'
      ''
      'set'
      '  Qt_Anterior = Coalesce( ('
      '    select'
      '      Old.Qt_Anterior + Old.Qt_Entradas - Old.Qt_Saidas'
      ''
      '    from'
      '      Inventario_Trimestral_Produto Old'
      ''
      '    where'
      '      Old.Cd_Filial     = Inventario_Trimestral_Produto.Cd_Filial and'
      '      Old.Nr_Ano        = :Nr_Old and'
      '      Old.Cd_Produto    = Inventario_Trimestral_Produto.Cd_Produto and'
      '      Old.Fl_Inventario = Inventario_Trimestral_Produto.Fl_Inventario'
      '    ), 0.0 )'
      ''
      'where'
      '  Cd_Filial = :Cd_Filial and'
      '  Nr_Ano    = :Nr_New'
    )
    SQLOther3.Strings = (
      '-------------------- Gera #InventarioMovto com saldos'
      'declare'
      '  @Cd_Filial SmallInt,'
      '  @Nr_Ano VarChar( 5 ),'
      '  @Dt_Start SmallDateTime,'
      '  @Dt_End SmallDateTime'
      ''
      'select'
      '  @Cd_Filial = :Cd_Filial,'
      '  @Nr_Ano    = :Nr_Ano,'
      '  @Dt_Start  = :Dt_Start,'
      '  @Dt_End    = :Dt_End'
      ''
      '  -- Inclui os itens'
      '  if Object_ID( ''''TempDB..#EstoqueRecalc'''' ) is not null'
      '    drop table #EstoqueRecalc'
      ''
      '  -- Saidas'
      '  select'
      '    SI.Cd_Produto, S.Fl_Estoque,'
      '    sum( SI.Qt_Estoque ) as Qt_Saida,'
      '    Qt_Entrada   = 0.0,'
      '    Qt_Orcamento = 0.0,'
      '    Qt_Reserva   = 0.0,'
      '    Qt_Balcao    = 0.0'
      ''
      '  into'
      '    #EstoqueRecalc'
      ''
      '  from'
      '    Saida S'
      ''
      '  inner join'
      '    CFOP CF'
      '  on'
      '    CF.Cd_CFOP    = S.Cd_CFOP and'
      '    CF.Tp_CFOP    = ''''1'''
      ''
      '  inner join'
      '    Saida_Item SI'
      '  on'
      '    SI.Cd_Filial   = S.Cd_Filial and'
      '    SI.Nr_Saida    = S.Nr_Saida'
      ''
      '  inner join'
      '    Inventario_Trimestral_Produto IP'
      '  on'
      '    IP.Cd_Filial  = S.Cd_Filial and'
      '    IP.Nr_Ano     = @Nr_Ano and'
      '    IP.Cd_Produto = SI.Cd_Produto'
      ''
      '  where'
      '    S.Cd_Filial      = @Cd_Filial and'
      '    S.St_Saida       = ''''2'''' and'
      '    S.Dt_Lancamento >= @Dt_Start and'
      '    S.Dt_Lancamento  < @Dt_End'
      ''
      '  group by'
      '    SI.Cd_Produto, S.Fl_Estoque'
      ''
      '  -- Entradas'
      '  union all'
      '  select'
      '    EI.Cd_Produto, E.Fl_Estoque,'
      '    Qt_Saida     = 0.0,'
      '    sum( EI.Qt_Estoque ) as Qt_Entrada,'
      '    Qt_Orcamento = 0.0,'
      '    Qt_Reserva   = 0.0,'
      '    Qt_Balcao    = 0.0'
      ''
      '  from'
      '    Entrada E'
      ''
      '  inner join'
      '    CFOP CF'
      '  on'
      '    CF.Cd_CFOP    = E.Cd_CFOP and'
      '    CF.Tp_CFOP    = ''''1'''
      ''
      '  inner join'
      '    Entrada_Item EI'
      '  on'
      '    EI.Cd_Filial   = E.Cd_Filial and'
      '    EI.Nr_Entrada  = E.Nr_Entrada'
      ''
      '  inner join'
      '    Inventario_Trimestral_Produto IP'
      '  on'
      '    IP.Cd_Filial  = EI.Cd_Filial and'
      '    IP.Nr_Ano     = @Nr_Ano and'
      '    IP.Cd_Produto = EI.Cd_Produto'
      ''
      '  where'
      '    E.Cd_Filial  = @Cd_Filial and'
      '    E.St_Entrada = ''''2'''' and'
      '    E.Dt_Lancamento >= @Dt_Start and'
      '    E.Dt_Lancamento  < @Dt_End'
      ''
      '  group by'
      '    EI.Cd_Produto, E.Fl_Estoque'
      ''
      '  -- Balcao - Saidas'
      '  union all'
      '  select'
      '    BI.Cd_Produto, B.Fl_Estoque,'
      '    Qt_Saida     = 0.0,'
      '    Qt_Entrada   = 0.0,'
      '    Qt_Orcamento = 0.0,'
      '    Qt_Reserva   = 0.0,'
      '    sum( BI.Qt_Item * Coalesce( PU.Nr_Fator, 1.0 ) ) as Qt_Balcao'
      ''
      '  from'
      '    Balcao B'
      ''
      '  inner join'
      '    Balcao_Item BI'
      '  on'
      '    BI.Cd_Filial = B.Cd_Filial and'
      '    BI.Nr_Balcao = B.Nr_Balcao'
      ''
      '  inner join'
      '    Inventario_Trimestral_Produto IP'
      '  on'
      '    IP.Cd_Filial  = BI.Cd_Filial and'
      '    IP.Nr_Ano     = @Nr_Ano and'
      '    IP.Cd_Produto = BI.Cd_Produto'
      ''
      '  inner join'
      '    Produto P'
      '  on'
      '    P.Cd_Produto = BI.Cd_Produto'
      ''
      '  inner join'
      '    Produto_Unidade PU'
      '  on'
      '    PU.Cd_Produto = P.Cd_Produto and'
      '    PU.Sg_Unidade = P.Sg_Venda'
      ''
      '  where'
      '    B.Cd_Filial = @Cd_Filial and'
      '    B.St_Balcao = ''''9'''' and'
      '    B.Dt_Fatura >= @Dt_Start and'
      '    B.Dt_Fatura  < @Dt_End'
      ''
      '  group by'
      '    BI.Cd_Produto, B.Fl_Estoque'
      ''
      '  -- Or'#231'amento - Saida'
      '  union all'
      '  -- Produto/Servi'#231'os'
      '  select'
      '    OI.Cd_Produto, O.Fl_Estoque,'
      '    Qt_Saida     = 0.0,'
      '    Qt_Entrada   = 0.0,'
      '    sum( OI.Qt_Estoque ) as Qt_Orcamento,'
      '    Qt_Reserva   = 0.0,'
      '    Qt_Balcao    = 0.0'
      ''
      '  from'
      '    Orcamento O'
      ''
      '  inner join'
      '    CFOP CF'
      '  on'
      '    CF.Cd_CFOP    = O.Cd_CFOP and'
      '    CF.Tp_CFOP    = ''''1'''
      ''
      '  inner join'
      '    Orcamento_Item OI'
      '  on'
      '    OI.Cd_Filial     = O.Cd_Filial and'
      '    OI.Nr_Orcamento  = O.Nr_Orcamento and'
      '    OI.Fl_Confirmado = ''''1'''
      ''
      '  inner join'
      '    Inventario_Trimestral_Produto IP'
      '  on'
      '    IP.Cd_Filial  = OI.Cd_Filial and'
      '    IP.Nr_Ano     = @Nr_Ano and'
      '    IP.Cd_Produto = OI.Cd_Produto'
      ''
      '  where'
      '    O.Cd_Filial    = @Cd_Filial and'
      '    O.St_Orcamento = ''''9'''' and'
      '    O.Dt_Fatura   >= @Dt_Start and'
      '    O.Dt_Fatura    < @Dt_End'
      ''
      '  group by'
      '    OI.Cd_Produto, O.Fl_Estoque'
      ''
      '  -- Conjunto'
      '  union all'
      '  select'
      '    OC.Cd_Produto, O.Fl_Estoque,'
      '    Qt_Saida     = 0.0,'
      '    Qt_Entrada   = 0.0,'
      '    sum( OC.Qt_Item * Coalesce( PU.Nr_Fator, 1.0 ) ) as Qt_Orcamento,'
      '    Qt_Reserva   = 0.0,'
      '    Qt_Balcao    = 0.0'
      ''
      '  from'
      '    Orcamento O'
      ''
      '  inner join'
      '    CFOP CF'
      '  on'
      '    CF.Cd_CFOP    = O.Cd_CFOP and'
      '    CF.Tp_CFOP    = ''''1'''
      ''
      '  inner join'
      '    Orcamento_Conjunto OC'
      '  on'
      '    OC.Cd_Filial     = O.Cd_Filial and'
      '    OC.Nr_Orcamento  = O.Nr_Orcamento'
      ''
      '  inner join'
      '    Inventario_Trimestral_Produto IP'
      '  on'
      '    IP.Cd_Filial  = OC.Cd_Filial and'
      '    IP.Nr_Ano     = @Nr_Ano and'
      '    IP.Cd_Produto = OC.Cd_Produto'
      ''
      '  inner join'
      '    Orcamento_Item OI'
      '  on'
      '    OI.Cd_Filial     = OC.Cd_Filial and'
      '    OI.Nr_Orcamento  = OC.Nr_Orcamento and'
      '    OI.Nr_Item       = OC.Nr_Item and'
      '    OI.Fl_Confirmado = ''''1'''
      ''
      '  left join'
      '    Produto_Unidade PU'
      '  on'
      '    PU.Cd_Produto = OC.Cd_Produto and'
      '    PU.Sg_Unidade = OC.Sg_Unidade'
      ''
      '  where'
      '    O.Cd_Filial    = @Cd_Filial and'
      '    O.St_Orcamento = ''''9'''' and'
      '    O.Dt_Fatura   >= @Dt_Start and'
      '    O.Dt_Fatura    < @Dt_End'
      ''
      '  group by'
      '    OC.Cd_Produto, O.Fl_Estoque'
      ''
      '  /* Projetos */'
      ''
      '  -- Cria a segunda table com os dados somados'
      '  if Object_ID( ''''TempDB..#EstoqueRecalcII'''' ) is not null'
      '    drop table #EstoqueRecalcII'
      ''
      '  select'
      '    Cd_Produto, Fl_Estoque,'
      '    Sum( Qt_Entrada ) as Qt_Entrada,'
      '    Sum( Qt_Saida ) as Qt_Saida,'
      '    Sum( Qt_Orcamento ) as Qt_Orcamento,'
      '    Sum( Qt_Reserva ) as Qt_Reserva,'
      '    Sum( Qt_Balcao ) as Qt_Balcao'
      ''
      '  into'
      '    #EstoqueRecalcII'
      ''
      '  from'
      '    #EstoqueRecalc'
      ''
      '  group by'
      '    Cd_Produto, Fl_Estoque'
      ''
      '  -- Atualizar o saldo anterior'
      '  if ( :Fl_SaldoAnterior = ''''1'''' )'
      '    update'
      '      Inventario_Trimestral_Produto'
      ''
      '    set'
      '      Qt_Anterior = ER.Qt_Entrada - ER.Qt_Saida - ER.Qt_Orcamento - ER.Qt_Reserva - ER.Qt_Balcao'
      ''
      '    from'
      '      #EstoqueRecalcII ER'
      ''
      '    inner join'
      '      Inventario_Trimestral_Produto IP'
      '    on'
      '      IP.Cd_Filial  = @Cd_Filial and'
      '      IP.Nr_Ano     = @Nr_Ano and'
      '      IP.Cd_Produto = ER.Cd_Produto'
      ''
      '    where'
      '      ER.Fl_Estoque = ''''1'''
      ''
      '  -- Atualiza as quantidades'
      '  else'
      '    update'
      '      Inventario_Trimestral_Produto'
      ''
      '    set'
      '      Qt_Entradas = ER.Qt_Entrada,'
      '      Qt_Saidas   = ER.Qt_Saida + ER.Qt_Orcamento + ER.Qt_Reserva + ER.Qt_Balcao'
      ''
      '    from'
      '      #EstoqueRecalcII ER'
      ''
      '    inner join'
      '      Inventario_Trimestral_Produto IP'
      '    on'
      '      IP.Cd_Filial  = @Cd_Filial and'
      '      IP.Nr_Ano     = @Nr_Ano and'
      '      IP.Cd_Produto = ER.Cd_Produto'
      ''
      '    where'
      '      ER.Fl_Estoque = ''''1'''
    )
    SQLOther4.Strings = (
      '-------------------- Elimina os itens sem movimenta'#231#227'o no ano'
      'delete from'
      '  Inventario_Trimestral_Produto'
      ''
      'where'
      '  Cd_Filial = :Cd_Filial and'
      '  Nr_Ano    = :Nr_Ano and'
      '  Qt_Entradas + Qt_Saidas <= 0.0'
    )
    SQLOther5.Strings = (
      '-------------------- Inclus'#227'o dos Projetos - SG'
      '  union all'
      '  -- Produto/Servi'#231'os'
      '  select'
      '    OPI.Cd_Produto, O.Fl_Estoque,'
      '    Qt_Saida     = 0.0,'
      '    Qt_Entrada   = 0.0,'
      '    sum( OPI.Qt_Item * OP.Qt_Projeto * Coalesce( PU.Nr_Fator, 1.0 ) ) as Qt_Orcamento,'
      '    Qt_Reserva   = 0.0,'
      '    Qt_Balcao    = 0.0'
      ''
      '  from'
      '    Orcamento O'
      ''
      '  inner join'
      '    CFOP CF'
      '  on'
      '    CF.Cd_CFOP    = O.Cd_CFOP and'
      '    CF.Tp_CFOP    = ''''1'''
      ''
      '  inner join'
      '    Orcamento_Projeto OP'
      '  on'
      '    OP.Cd_Filial     = O.Cd_Filial and'
      '    OP.Nr_Orcamento  = O.Nr_Orcamento'
      ''
      '  inner join'
      '    Orcamento_Projeto_Item OPI'
      '  on'
      '    OPI.Cd_Filial    = OP.Cd_Filial and'
      '    OPI.Nr_Orcamento = OP.Nr_Orcamento and'
      '    OPI.Nr_Projeto   = OP.Nr_Projeto '
      ''
      '  inner join'
      '    Inventario_Trimestral_Produto IP'
      '  on'
      '    IP.Cd_Filial  = OPI.Cd_Filial and'
      '    IP.Nr_Ano     = @Nr_Ano and'
      '    IP.Cd_Produto = OPI.Cd_Produto'
      ''
      '  inner join'
      '    Produto_Unidade PU'
      '  on'
      '    PU.Cd_Produto = OPI.Cd_Produto and'
      '    PU.Sg_Unidade = OPI.Sg_Unidade'
      ''
      '  where'
      '    O.Cd_Filial    = @Cd_Filial and'
      '    O.St_Orcamento = ''''9'''' and'
      '    O.Dt_Fatura   >= @Dt_Start and'
      '    O.Dt_Fatura    < @Dt_End'
      ''
      '  group by'
      '    OPI.Cd_Produto, O.Fl_Estoque'
      ''
    )
    SQLOther6.Strings = (
      '-------------------- Importa os produtos - pelo Fl_Inventario de CFOP'
      'declare'
      '  @Cd_Filial SmallInt,'
      '  @Nr_Ano VarChar( 5 )'
      ''
      'select'
      '  @Cd_Filial = :Cd_Filial,'
      '  @Nr_Ano    = :Nr_Ano'
      ''
      'insert into Inventario_Trimestral_Produto( Cd_Filial, Nr_Ano, Cd_Produto, Qt_Anterior,'
      '  Qt_Entradas, Qt_Saidas, Vl_Custo, Fl_Inventario )'
      ''
      'select'
      '  @Cd_Filial, @Nr_Ano, P.Cd_Produto, 0, 0, 0, Coalesce( PP.Vl_Custo, 0.01 ),'
      '  /* Fl_Inventario */'
      ''
      'from'
      '  Produto P'
      ''
      'left join'
      '  Produto_Preco PP'
      'on'
      '  PP.Cd_Tabela  = :Cd_Tabela and'
      '  PP.Cd_Produto = P.Cd_Produto'
      ''
      'where'
      '  P.Fl_Produto = ''''1'''' and'
      '  '
      '  not exists('
      '    select'
      '      IP.Cd_Produto'
      ''
      '    from'
      '      Inventario_Trimestral_Produto IP'
      ''
      '    where'
      '      IP.Cd_Filial     = @Cd_Filial and'
      '      IP.Nr_Ano        = @Nr_Ano and'
      '      IP.Cd_Produto    = P.Cd_Produto and'
      '      IP.Fl_Inventario = /* Fl_Inventario */'
      ''
      '    )'
      ''
      '  /* Fl_Ativo */'
    )
    SQLOther7.Strings = (
      '-------------------- Gera #InventarioMovto com saldos - utilizando CFOP'
      'declare'
      '  @Cd_Filial SmallInt,'
      '  @Nr_Ano VarChar( 5 ),'
      '  @Dt_Start SmallDateTime,'
      '  @Dt_End SmallDateTime'
      ''
      'select'
      '  @Cd_Filial = :Cd_Filial,'
      '  @Nr_Ano    = :Nr_Ano,'
      '  @Dt_Start  = :Dt_Start,'
      '  @Dt_End    = :Dt_End'
      ''
      '  -- Inclui os itens'
      '  if Object_ID( ''''TempDB..#EstoqueRecalc'''' ) is not null'
      '    drop table #EstoqueRecalc'
      ''
      '  -- Saidas'
      '  select'
      '    SI.Cd_Produto, S.Fl_Estoque, CFInv.Fl_Inventario,'
      '    sum( SI.Qt_Estoque ) as Qt_Saida,'
      '    Qt_Entrada   = 0.0,'
      '    Qt_Orcamento = 0.0,'
      '    Qt_Reserva   = 0.0,'
      '    Qt_Balcao    = 0.0'
      ''
      '  into'
      '    #EstoqueRecalc'
      ''
      '  from'
      '    Saida S'
      ''
      '  inner join                ----- Trata para definir se gera movimento'
      '    CFOP CF'
      '  on'
      '    CF.Cd_CFOP    = S.Cd_CFOP and'
      '    CF.Tp_CFOP    = ''''1'''
      ''
      '  inner join'
      '    Saida_Item SI'
      '  on'
      '    SI.Cd_Filial   = S.Cd_Filial and'
      '    SI.Nr_Saida    = S.Nr_Saida'
      ''
      '  inner join'
      '    Produto P'
      '  on'
      '    P.Cd_Produto = SI.Cd_Produto'
      ''
      '  inner join'
      '    Tributacao T'
      '  on'
      '    T.Cd_Tributacao = P.Cd_Tributacao'
      ''
      '  inner join'
      '    Emitente E'
      '  on'
      '    E.Cd_Emitente = S.Cd_Emitente'
      ''
      '  inner join'
      '    Emitente_Endereco EE'
      '  on'
      '    EE.Cd_Emitente = E.Cd_Emitente and'
      '    EE.Nr_Endereco = E.Nr_Endereco'
      ''
      '  inner join'
      '    Cidade CE'
      '  on'
      '    CE.Cd_Cidade = EE.Cd_Cidade'
      ''
      '  inner join'
      '    Filial F'
      '  on'
      '    F.Cd_Filial = S.Cd_Filial'
      ''
      '  inner join'
      '    Cidade CiF'
      '  on'
      '    CiF.Cd_Cidade = F.Cd_Cidade'
      ''
      '  inner join                ----- Determina o Fl_Inventario'
      '    CFOP CFInv'
      '  on'
      '    CFInv.Cd_CFOP ='
      '      case'
      '        when CiF.Sg_Estado = CE.Sg_Estado then Coalesce( T.Cd_CFOPDentro, S.Cd_CFOP )'
      '        else Coalesce( T.Cd_CFOPFora, S.Cd_CFOP )'
      ''
      '      end'
      ''
      '  inner join'
      '    Inventario_Trimestral_Produto IP'
      '  on'
      '    IP.Cd_Filial     = S.Cd_Filial and'
      '    IP.Nr_Ano        = @Nr_Ano and'
      '    IP.Cd_Produto    = SI.Cd_Produto and'
      '    IP.Fl_Inventario = CFInv.Fl_Inventario'
      ''
      '  where'
      '    S.Cd_Filial      = @Cd_Filial and'
      '    S.St_Saida       = ''''2'''' and'
      '    S.Dt_Lancamento >= @Dt_Start and'
      '    S.Dt_Lancamento  < @Dt_End'
      ''
      '  group by'
      '    SI.Cd_Produto, S.Fl_Estoque, CFInv.Fl_Inventario'
      ''
      '  -- Entradas'
      '  union all'
      '  select'
      '    EI.Cd_Produto, E.Fl_Estoque, EI.Fl_Inventario,'
      '    Qt_Saida     = 0.0,'
      '    sum( EI.Qt_Estoque ) as Qt_Entrada,'
      '    Qt_Orcamento = 0.0,'
      '    Qt_Reserva   = 0.0,'
      '    Qt_Balcao    = 0.0'
      ''
      '  from'
      '    Entrada E'
      ''
      '  inner join                ----- Trata para definir se gera movimento'
      '    CFOP CF'
      '  on'
      '    CF.Cd_CFOP    = E.Cd_CFOP and'
      '    CF.Tp_CFOP    = ''''1'''
      ''
      '  inner join'
      '    Entrada_Item EI'
      '  on'
      '    EI.Cd_Filial   = E.Cd_Filial and'
      '    EI.Nr_Entrada  = E.Nr_Entrada'
      ''
      '  inner join                ----- Determina o Fl_Inventario'
      '    CFOP CFInv'
      '  on'
      '    CFInv.Cd_CFOP = Coalesce( EI.Cd_CFOP, E.Cd_CFOP )'
      ''
      '  inner join'
      '    Inventario_Trimestral_Produto IP'
      '  on'
      '    IP.Cd_Filial     = EI.Cd_Filial and'
      '    IP.Nr_Ano        = @Nr_Ano and'
      '    IP.Cd_Produto    = EI.Cd_Produto and'
      '    IP.Fl_Inventario = CFInv.Fl_Inventario'
      ''
      '  where'
      '    E.Cd_Filial  = @Cd_Filial and'
      '    E.St_Entrada = ''''2'''' and'
      '    E.Dt_Lancamento >= @Dt_Start and'
      '    E.Dt_Lancamento  < @Dt_End'
      ''
      '  group by'
      '    EI.Cd_Produto, E.Fl_Estoque, EI.Fl_Inventario'
      ''
      '  -- Or'#231'amento - Saida'
      '  union all'
      '  -- Produto/Servi'#231'os'
      '  select'
      '    OI.Cd_Produto, O.Fl_Estoque, CFInv.Fl_Inventario,'
      '    Qt_Saida     = 0.0,'
      '    Qt_Entrada   = 0.0,'
      '    sum( OI.Qt_Estoque ) as Qt_Orcamento,'
      '    Qt_Reserva   = 0.0,'
      '    Qt_Balcao    = 0.0'
      ''
      '  from'
      '    Orcamento O'
      ''
      '  inner join                ----- Trata para definir se gera movimento'
      '    CFOP CF'
      '  on'
      '    CF.Cd_CFOP    = O.Cd_CFOP and'
      '    CF.Tp_CFOP    = ''''1'''
      ''
      '  inner join'
      '    Orcamento_Item OI'
      '  on'
      '    OI.Cd_Filial     = O.Cd_Filial and'
      '    OI.Nr_Orcamento  = O.Nr_Orcamento and'
      '    OI.Fl_Confirmado = ''''1'''
      ''
      '  inner join'
      '    Produto P'
      '  on'
      '    P.Cd_Produto = OI.Cd_Produto'
      ''
      '  inner join'
      '    Tributacao T'
      '  on'
      '    T.Cd_Tributacao = P.Cd_Tributacao'
      ''
      '  inner join'
      '    Emitente E'
      '  on'
      '    E.Cd_Emitente = O.Cd_Emitente'
      ''
      '  inner join'
      '    Emitente_Endereco EE'
      '  on'
      '    EE.Cd_Emitente = E.Cd_Emitente and'
      '    EE.Nr_Endereco = E.Nr_Endereco'
      ''
      '  inner join'
      '    Cidade CE'
      '  on'
      '    CE.Cd_Cidade = EE.Cd_Cidade'
      ''
      '  inner join'
      '    Filial F'
      '  on'
      '    F.Cd_Filial = O.Cd_Filial'
      ''
      '  inner join'
      '    Cidade CiF'
      '  on'
      '    CiF.Cd_Cidade = F.Cd_Cidade'
      ''
      '  inner join                ----- Determina o Fl_Inventario'
      '    CFOP CFInv'
      '  on'
      '    CFInv.Cd_CFOP ='
      '      case'
      '        when CiF.Sg_Estado = CE.Sg_Estado then Coalesce( T.Cd_CFOPDentro, O.Cd_CFOP )'
      '        else Coalesce( T.Cd_CFOPFora, O.Cd_CFOP )'
      ''
      '      end'
      ''
      '  inner join'
      '    Inventario_Trimestral_Produto IP'
      '  on'
      '    IP.Cd_Filial     = OI.Cd_Filial and'
      '    IP.Nr_Ano        = @Nr_Ano and'
      '    IP.Cd_Produto    = OI.Cd_Produto and'
      '    IP.Fl_Inventario = CFInv.Fl_Inventario'
      ''
      '  where'
      '    O.Cd_Filial    = @Cd_Filial and'
      '    O.St_Orcamento = ''''9'''' and'
      '    O.Dt_Fatura   >= @Dt_Start and'
      '    O.Dt_Fatura    < @Dt_End'
      ''
      '  group by'
      '    OI.Cd_Produto, O.Fl_Estoque, CFInv.Fl_Inventario'
      ''
      '  -- Conjunto'
      '  union all'
      '  select'
      '    OC.Cd_Produto, O.Fl_Estoque, CFInv.Fl_Inventario,'
      '    Qt_Saida     = 0.0,'
      '    Qt_Entrada   = 0.0,'
      '    sum( OC.Qt_Item * Coalesce( PU.Nr_Fator, 1.0 ) ) as Qt_Orcamento,'
      '    Qt_Reserva   = 0.0,'
      '    Qt_Balcao    = 0.0'
      ''
      '  from'
      '    Orcamento O'
      ''
      '  inner join                ----- Trata para definir se gera movimento'
      '    CFOP CF'
      '  on'
      '    CF.Cd_CFOP    = O.Cd_CFOP and'
      '    CF.Tp_CFOP    = ''''1'''
      ''
      '  inner join'
      '    Orcamento_Conjunto OC'
      '  on'
      '    OC.Cd_Filial     = O.Cd_Filial and'
      '    OC.Nr_Orcamento  = O.Nr_Orcamento'
      ''
      '  inner join'
      '    Produto P'
      '  on'
      '    P.Cd_Produto = OC.Cd_Produto'
      ''
      '  inner join'
      '    Tributacao T'
      '  on'
      '    T.Cd_Tributacao = P.Cd_Tributacao'
      ''
      '  inner join'
      '    Emitente E'
      '  on'
      '    E.Cd_Emitente = O.Cd_Emitente'
      ''
      '  inner join'
      '    Emitente_Endereco EE'
      '  on'
      '    EE.Cd_Emitente = E.Cd_Emitente and'
      '    EE.Nr_Endereco = E.Nr_Endereco'
      ''
      '  inner join'
      '    Cidade CE'
      '  on'
      '    CE.Cd_Cidade = EE.Cd_Cidade'
      ''
      '  inner join'
      '    Filial F'
      '  on'
      '    F.Cd_Filial = O.Cd_Filial'
      ''
      '  inner join'
      '    Cidade CiF'
      '  on'
      '    CiF.Cd_Cidade = F.Cd_Cidade'
      ''
      '  inner join                ----- Determina o Fl_Inventario'
      '    CFOP CFInv'
      '  on'
      '    CFInv.Cd_CFOP ='
      '      case'
      '        when CiF.Sg_Estado = CE.Sg_Estado then Coalesce( T.Cd_CFOPDentro, O.Cd_CFOP )'
      '        else Coalesce( T.Cd_CFOPFora, O.Cd_CFOP )'
      ''
      '      end'
      ''
      '  inner join'
      '    Inventario_Trimestral_Produto IP'
      '  on'
      '    IP.Cd_Filial     = OC.Cd_Filial and'
      '    IP.Nr_Ano        = @Nr_Ano and'
      '    IP.Cd_Produto    = OC.Cd_Produto and'
      '    IP.Fl_Inventario = CFInv.Fl_Inventario'
      ''
      '  inner join'
      '    Orcamento_Item OI'
      '  on'
      '    OI.Cd_Filial     = OC.Cd_Filial and'
      '    OI.Nr_Orcamento  = OC.Nr_Orcamento and'
      '    OI.Nr_Item       = OC.Nr_Item and'
      '    OI.Fl_Confirmado = ''''1'''
      ''
      '  left join'
      '    Produto_Unidade PU'
      '  on'
      '    PU.Cd_Produto = OC.Cd_Produto and'
      '    PU.Sg_Unidade = OC.Sg_Unidade'
      ''
      '  where'
      '    O.Cd_Filial    = @Cd_Filial and'
      '    O.St_Orcamento = ''''9'''' and'
      '    O.Dt_Fatura   >= @Dt_Start and'
      '    O.Dt_Fatura    < @Dt_End'
      ''
      '  group by'
      '    OC.Cd_Produto, O.Fl_Estoque, CFInv.Fl_Inventario'
      ''
      '  /* Inicio Projetos'
      ''
      '-------------------- Inclus'#227'o dos Projetos - SG'
      '  union all'
      '  -- Produto/Servi'#231'os'
      '  select'
      '    OPI.Cd_Produto, O.Fl_Estoque, CFInv.Fl_Inventario,'
      '    Qt_Saida     = 0.0,'
      '    Qt_Entrada   = 0.0,'
      '    sum( OPI.Qt_Item * OP.Qt_Projeto * Coalesce( PU.Nr_Fator, 1.0 ) ) as Qt_Orcamento,'
      '    Qt_Reserva   = 0.0,'
      '    Qt_Balcao    = 0.0'
      ''
      '  from'
      '    Orcamento O'
      ''
      '  inner join'
      '    CFOP CF'
      '  on'
      '    CF.Cd_CFOP    = O.Cd_CFOP and'
      '    CF.Tp_CFOP    = ''''1'''
      ''
      '  inner join'
      '    Orcamento_Projeto OP'
      '  on'
      '    OP.Cd_Filial     = O.Cd_Filial and'
      '    OP.Nr_Orcamento  = O.Nr_Orcamento'
      ''
      '  inner join'
      '    Orcamento_Projeto_Item OPI'
      '  on'
      '    OPI.Cd_Filial    = OP.Cd_Filial and'
      '    OPI.Nr_Orcamento = OP.Nr_Orcamento and'
      '    OPI.Nr_Projeto   = OP.Nr_Projeto'
      ''
      '  inner join'
      '    Produto P'
      '  on'
      '    P.Cd_Produto = OPI.Cd_Produto'
      ''
      '  inner join'
      '    Tributacao T'
      '  on'
      '    T.Cd_Tributacao = P.Cd_Tributacao'
      ''
      '  inner join'
      '    Emitente E'
      '  on'
      '    E.Cd_Emitente = O.Cd_Emitente'
      ''
      '  inner join'
      '    Emitente_Endereco EE'
      '  on'
      '    EE.Cd_Emitente = E.Cd_Emitente and'
      '    EE.Nr_Endereco = E.Nr_Endereco'
      ''
      '  inner join'
      '    Cidade CE'
      '  on'
      '    CE.Cd_Cidade = EE.Cd_Cidade'
      ''
      '  inner join'
      '    Filial F'
      '  on'
      '    F.Cd_Filial = O.Cd_Filial'
      ''
      '  inner join'
      '    Cidade CiF'
      '  on'
      '    CiF.Cd_Cidade = F.Cd_Cidade'
      ''
      '  inner join                ----- Determina o Fl_Inventario'
      '    CFOP CFInv'
      '  on'
      '    CFInv.Cd_CFOP ='
      '      case'
      '        when CiF.Sg_Estado = CE.Sg_Estado then Coalesce( T.Cd_CFOPDentro, O.Cd_CFOP )'
      '        else Coalesce( T.Cd_CFOPFora, O.Cd_CFOP )'
      ''
      '      end'
      ''
      '  inner join'
      '    Inventario_Trimestral_Produto IP'
      '  on'
      '    IP.Cd_Filial     = OPI.Cd_Filial and'
      '    IP.Nr_Ano        = @Nr_Ano and'
      '    IP.Cd_Produto    = OPI.Cd_Produto and'
      '    IP.Fl_Inventario = CFInv.Fl_Inventario'
      ''
      '  inner join'
      '    Produto_Unidade PU'
      '  on'
      '    PU.Cd_Produto = OPI.Cd_Produto and'
      '    PU.Sg_Unidade = OPI.Sg_Unidade'
      ''
      '  where'
      '    O.Cd_Filial    = @Cd_Filial and'
      '    O.St_Orcamento = ''''9'''' and'
      '    O.Dt_Fatura   >= @Dt_Start and'
      '    O.Dt_Fatura    < @Dt_End'
      ''
      '  group by'
      '    OPI.Cd_Produto, O.Fl_Estoque, CFInv.Fl_Inventario'
      ''
      '  Fim Projetos */'
      ''
      '  -- Cria a segunda table com os dados somados'
      '  if Object_ID( ''''TempDB..#EstoqueRecalcII'''' ) is not null'
      '    drop table #EstoqueRecalcII'
      ''
      '  select'
      '    Cd_Produto, Fl_Estoque, Fl_Inventario,'
      '    Sum( Qt_Entrada ) as Qt_Entrada,'
      '    Sum( Qt_Saida ) as Qt_Saida,'
      '    Sum( Qt_Orcamento ) as Qt_Orcamento,'
      '    Sum( Qt_Reserva ) as Qt_Reserva,'
      '    Sum( Qt_Balcao ) as Qt_Balcao'
      ''
      '  into'
      '    #EstoqueRecalcII'
      ''
      '  from'
      '    #EstoqueRecalc'
      ''
      '  group by'
      '    Cd_Produto, Fl_Estoque, Fl_Inventario'
      ''
      '  /* Produto para Baixa */'
      ''
      '  -- Atualizar o saldo anterior'
      '  if ( :Fl_SaldoAnterior = ''''1'''' )'
      '    update'
      '      Inventario_Trimestral_Produto'
      ''
      '    set'
      '      Qt_Anterior = ER.Qt_Entrada - ER.Qt_Saida - ER.Qt_Orcamento - ER.Qt_Reserva - ER.Qt_Balcao'
      ''
      '    from'
      '      #EstoqueRecalcII ER'
      ''
      '    inner join'
      '      Inventario_Trimestral_Produto IP'
      '    on'
      '      IP.Cd_Filial     = @Cd_Filial and'
      '      IP.Nr_Ano        = @Nr_Ano and'
      '      IP.Cd_Produto    = ER.Cd_Produto and'
      '      IP.Fl_Inventario = IP.Fl_Inventario'
      ''
      '    where'
      '      ER.Fl_Estoque = ''''1'''
      ''
      '  -- Atualiza as quantidades'
      '  else'
      '    update'
      '      Inventario_Trimestral_Produto'
      ''
      '    set'
      '      Qt_Entradas = ER.Qt_Entrada,'
      '      Qt_Saidas   = ER.Qt_Saida + ER.Qt_Orcamento + ER.Qt_Reserva + ER.Qt_Balcao'
      ''
      '    from'
      '      #EstoqueRecalcII ER'
      ''
      '    inner join'
      '      Inventario_Trimestral_Produto IP'
      '    on'
      '      IP.Cd_Filial     = @Cd_Filial and'
      '      IP.Nr_Ano        = @Nr_Ano and'
      '      IP.Cd_Produto    = ER.Cd_Produto and'
      '      IP.Fl_Inventario = ER.Fl_Inventario'
      ''
      '    where'
      '      ER.Fl_Estoque = ''''1'''
    )
    SQLOther8.Strings = (
      '--------------- Itens para baixa'
      'if Object_ID( ''''TempDB..#EstoqueRecalcIII'''' ) is not null'
      '  drop table #EstoqueRecalcIII'
      ''
      'select'
      '  ER.Cd_Produto, ER.Fl_Estoque, ER.Fl_Inventario,'
      '  IsNull( P.Cd_Baixa, ER.Cd_Produto ) as Cd_Baixa,'
      '  Sum( Qt_Entrada ) as Qt_Entrada,'
      '  Sum( Qt_Saida ) as Qt_Saida,'
      '  Sum( Qt_Orcamento ) as Qt_Orcamento,'
      '  Sum( Qt_Reserva ) as Qt_Reserva,'
      '  Sum( Qt_Balcao ) as Qt_Balcao'
      ''
      'into'
      '  #EstoqueRecalcIII'
      ''
      'from'
      '  #EstoqueRecalcII ER'
      ''
      'inner join'
      '  Produto P'
      'on'
      '  P.Cd_Produto = ER.Cd_Produto'
      ''
      'group by'
      '  ER.Cd_Produto, ER.Fl_Estoque, ER.Fl_Inventario, IsNull( P.Cd_Baixa, ER.Cd_Produto )'
      ''
      'delete from #EstoqueRecalcII'
      'insert into #EstoqueRecalcII'
      'select'
      '  ER.Cd_Baixa as Cd_Produto, ER.Fl_Estoque, ER.Fl_Inventario,'
      '  Sum( Qt_Entrada ) as Qt_Entrada,'
      '  Sum( Qt_Saida ) as Qt_Saida,'
      '  Sum( Qt_Orcamento ) as Qt_Orcamento,'
      '  Sum( Qt_Reserva ) as Qt_Reserva,'
      '  Sum( Qt_Balcao ) as Qt_Balcao'
      ''
      'from'
      '  #EstoqueRecalcIII ER'
      ''
      'group by'
      '  ER.Cd_Baixa, ER.Fl_Estoque, ER.Fl_Inventario'
      ''
      ''
    )
    Left = 358
    Top = 66
  end
end
